# =============================================================================
#  Sekarya API — contoh konfigurasi PRODUKSI (shared hosting)
# =============================================================================
#  Salin jadi `.env` di server, lalu isi nilainya. JANGAN commit berkas .env.
#
#  APP_KEY wajib diisi. Kalau ada SSH:  php artisan key:generate
#  Kalau tidak ada SSH, jalankan perintah itu di komputer sendiri lalu salin
#  hasilnya ke sini. Mengganti APP_KEY setelah aplikasi berjalan membuat
#  seluruh data terenkripsi (nomor dokumen, nomor rekening) TIDAK BISA dibaca
#  lagi — kunci ini tidak boleh berubah setelah ada data masuk.
# =============================================================================

APP_NAME=Sekarya
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.domainanda.id

# APP_DEBUG=true di produksi menampilkan jejak galat lengkap kepada siapa pun
# yang memicu error — termasuk kueri, path server, dan potongan kode.

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=UTC

# UTC, dan biarkan begitu. Seluruh timestamp disimpan UTC; pengubahan zona
# waktu adalah urusan tampilan di klien, bukan penyimpanan.

APP_MAINTENANCE_DRIVER=file

# ── Basis data ───────────────────────────────────────────────────────────────
# Di cPanel, nama basis data dan pengguna otomatis diberi awalan nama akun,
# mis. `akunanda_sekarya`. Tulis nama LENGKAPNYA di sini.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akunanda_sekarya
DB_USERNAME=akunanda_sekarya
DB_PASSWORD=

# WAJIB. Tanpa ini zona waktu sesi MySQL mengikuti host, sehingga `NOW()` di SQL
# dan `now()` di PHP bisa berbeda berjam-jam — dan setiap timestamp yang
# dihitung server memakai jam yang berbeda dari kode yang menulis datanya.
DB_TIMEZONE=+00:00

# ── Penyimpanan sesi, cache, antrean ─────────────────────────────────────────
# Semuanya `database`: shared hosting tidak menyediakan Redis, dan tabelnya
# sudah ikut di berkas pemasangan.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Log ──────────────────────────────────────────────────────────────────────
# `daily` supaya berkas log tidak tumbuh tanpa batas — kuota disk shared hosting
# terbatas, dan satu berkas log raksasa bisa menghabiskannya diam-diam.

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ── Email ────────────────────────────────────────────────────────────────────
# WAJIB berfungsi: pendaftaran tidak bisa diselesaikan tanpa kode verifikasi
# yang dikirim lewat email. Isi dengan akun email cPanel atau layanan SMTP.

MAIL_MAILER=smtp
MAIL_HOST=mail.domainanda.id
MAIL_PORT=465
MAIL_USERNAME=noreply@domainanda.id
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=noreply@domainanda.id
MAIL_FROM_NAME="${APP_NAME}"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Sebutkan asal yang sah, dipisah koma. JANGAN `*` — dan jangan menyalakan
# supports_credentials: API ini memakai Bearer token, bukan cookie.

CORS_ALLOWED_ORIGINS=https://app.domainanda.id,https://admin.domainanda.id

# ── Aturan aplikasi ──────────────────────────────────────────────────────────
# Seluruh angkanya di config/sekarya.php; yang di bawah hanya yang biasa diubah.

SEKARYA_ACCESS_TTL_HOURS=8
SEKARYA_LONG_LIVED_TTL_DAYS=30
SEKARYA_VERIFICATION_TTL_MINUTES=15
SEKARYA_RESEND_COOLDOWN_SECONDS=60

# NYALAKAN di produksi. Seluruh alur bergantung pada email yang benar-benar
# bisa dihubungi, jadi domain salah ketik lebih baik ditolak di depan.
SEKARYA_VALIDATE_EMAIL_DNS=true

# Gerbang pembayaran. Mati = activity dibuka begitu perekrutan ditutup, tanpa
# menunggu konfirmasi transfer — keadaan SEMENTARA selama mekanisme pembayaran
# belum dikembangkan. Nyalakan begitu pembayaran siap: selama mati, pekerjaan
# berjalan atas uang yang belum tentu masuk.
SEKARYA_PAYMENT_GATE=false

# Batas umur yang boleh diisi di profil (dihitung dari tanggal lahir; umur
# TIDAK pernah disimpan sebagai kolom). 17 adalah usia KTP, dan verifikasi
# identitas di aplikasi ini mencocokkan dengan KTP — orang yang belum bisa
# punya KTP tidak akan pernah lolos verifikasi. Batas atasnya bukan aturan
# bisnis melainkan penjaga salah ketik: tahun 1025 lolos sebagai tanggal sah.
SEKARYA_MIN_AGE=17
SEKARYA_MAX_AGE=100

# ── Saldo (dompet) ────────────────────────────────────────────────────────────
#
# Nominal dalam rupiah, bilangan bulat. Batas bawah menjaga antrean pengelola:
# setiap isi ulang dan setiap pencairan menghabiskan satu tindakan manual
# (mencocokkan mutasi rekening), dan biayanya sama berapa pun nominalnya.
# Batas atas per permintaan bukan batas saldo — ia membatasi kerugian satu
# kesalahan konfirmasi, dan menahan salah ketik nol.
SEKARYA_WALLET_MIN_TOPUP=10000
SEKARYA_WALLET_MAX_TOPUP=10000000
SEKARYA_WALLET_MIN_WITHDRAWAL=50000
SEKARYA_WALLET_MAX_WITHDRAWAL=10000000

# Berapa permintaan saldo yang boleh menunggu keputusan pengelola sekaligus,
# per orang. BUKAN rate limit: rate limit membatasi kecepatan, ini membatasi
# jumlah yang menggantung. Tiga per menit selama sehari tetap lolos rate limit
# dan tetap meninggalkan ribuan baris yang harus dibuka satu per satu — dan
# yang menunggu di belakangnya pekerja yang benar-benar menunggu uangnya.
SEKARYA_WALLET_MAX_PENDING=3

# Rekening tujuan isi saldo (transfer manual), JSON larik. Tampil di layar Isi
# Saldo lewat GET me/wallet/config. KOSONG = rekening tidak ditampilkan.
# Nomor rekening NYATA wajib dicek manusia sebelum diisi ke produksi.
# Contoh:
# SEKARYA_TOPUP_ACCOUNTS=[{"bank_code":"BCA","bank_name":"Bank Central Asia","account_number":"1234567890","account_holder":"PT Sekarya Digital"}]
SEKARYA_TOPUP_ACCOUNTS=

# Minimum foto bukti saat pekerja menyerahkan hasil (POST activities/{a}/submit).
# Foto adalah dasar penyelesaian sengketa; 0 membuatnya opsional lagi.
SEKARYA_MIN_PROOF_PHOTOS=1

# Batas laju per menit. Turunkan kalau shared hosting-nya mudah kewalahan.
SEKARYA_RL_API=120
SEKARYA_RL_LOGIN=5
SEKARYA_RL_REGISTER=5
SEKARYA_RL_VERIFY=6
SEKARYA_RL_RESEND=3
SEKARYA_RL_REFRESH=10
SEKARYA_RL_WRITE=30

# Endpoint pengelola. Lebih longgar dari SEKARYA_RL_API: menilai antrean berarti
# membuka banyak halaman berturut-turut, dan yang memakainya cuma beberapa akun
# internal. Login pengelola justru yang paling ketat — di situlah percobaan
# menebak sandi akun yang bisa menyetujui pembayaran terjadi.
SEKARYA_RL_ADMIN=240
SEKARYA_RL_ADMIN_LOGIN=5

# ── Akun super_admin ─────────────────────────────────────────────────────────
# WAJIB DIISI SENDIRI, dan jangan pernah memakai nilai contoh dari
# .env.example: nilai itu terlacak git, jadi ia bukan kredensial.
#
# Akun ini TIDAK ada di database/schema/sekarya-install.sql dan tidak ada
# seeder-nya — keduanya terlacak git juga. Ia dibuat sekali, setelah deploy:
#
#   php artisan sekarya:admin create
#
# Perintah itu menolak sandi contoh saat APP_ENV=production, dan menolak sandi
# di bawah 12 karakter di lingkungan mana pun. Akun ini tidak bisa dihapus dan
# tidak bisa dinonaktifkan — ia satu-satunya yang bisa membuat pengelola lain.
SEKARYA_SUPER_ADMIN_NAME="Super Admin"
SEKARYA_SUPER_ADMIN_EMAIL=
SEKARYA_SUPER_ADMIN_PASSWORD=

# ── Observability (opsional) ─────────────────────────────────────────────────
# Biarkan false sampai token diisi dan hasil penyaringannya diperiksa dengan
# `php artisan sekarya:axiom --audit`. Selama false, tidak ada data yang keluar.
#
# `sync` di shared hosting: tanpa worker yang berjalan terus, `queue` berarti
# log baru terkirim saat cron berikutnya jalan.

AXIOM_ENABLED=false
AXIOM_TOKEN=
AXIOM_DATASET=sekarya
AXIOM_SERVICE=sekarya-api
AXIOM_DELIVERY=sync
AXIOM_IP_MODE=prefix_hash
AXIOM_REQUEST_PAYLOAD=redacted
AXIOM_RESPONSE_PAYLOAD=errors_only

# Kirim juga Log::* aplikasi. Jangan hilangkan `daily`: kalau Axiom tidak
# terjangkau, jejak galat harus tetap ada di server.
# LOG_STACK=daily,axiom

# ── Firebase Cloud Messaging (push notification) ─────────────────────────────
# WAJIB diisi agar notifikasi push benar-benar terkirim. Kalau `false` atau
# berkasnya tidak ada, SELURUH pengiriman dilewati dengan tenang — tanpa galat,
# tanpa log — sehingga gejalanya "notifikasi tidak pernah masuk".
#
# Berkas JSON service account diunduh dari Firebase Console > Project Settings
# > Service Accounts > Generate new private key. Simpan DI LUAR git, mis.
# storage/app/firebase/service-account.json, lalu tunjuk PATH ABSOLUT-nya.
# Pastikan berkasnya benar-benar ada di server (is_file) sebelum menyalakan.
#
# Project service account HARUS sama dengan project `google-services.json` yang
# dipakai aplikasi Android. Setelah mengubah nilai di sini, jalankan ulang
# `php artisan config:cache`.
#
# CATATAN OPERASIONAL: job `SendPushNotification` memakai antrean
# (`QUEUE_CONNECTION=database`). Tanpa cron pekerja antrean di bagian Cron,
# job hanya menumpuk di tabel `jobs` dan tidak pernah dikirim. Lihat
# docs/DEPLOYMENT.md bagian 8.

FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS=
FIREBASE_TIMEOUT=10

VITE_APP_NAME="${APP_NAME}"
