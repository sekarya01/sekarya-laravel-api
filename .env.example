APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sekarya
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SEKARYA_VALIDATE_EMAIL_DNS=true

# ── Gerbang pembayaran ───────────────────────────────────────────────────────
# SEMENTARA mati: mekanisme pembayaran belum dikembangkan, jadi activity dibuka
# begitu perekrutan ditutup dan pekerja bisa langsung mulai. Isi `true` untuk
# mengembalikan alur yang dirancang — lapor transfer → pengelola konfirmasi →
# pekerjaan terbuka. Lihat config/sekarya.php.
SEKARYA_PAYMENT_GATE=false

# ── Akun pengelola bawaan ────────────────────────────────────────────────────
# Dipakai `php artisan sekarya:admin create` kalau opsinya tidak disebut.
#
# Nilai di bawah ini kredensial PENGEMBANGAN dan ikut terlacak git — siapa pun
# yang membuka repositori bisa membacanya. Di produksi perintah itu MENOLAK
# sandi ini; lihat .env.production.example.
SEKARYA_SUPER_ADMIN_NAME="Super Admin"
SEKARYA_SUPER_ADMIN_EMAIL=super@sekarya.test
SEKARYA_SUPER_ADMIN_PASSWORD=SuperAdminSekarya2026

DB_TIMEZONE=+00:00

AXIOM_TOKEN=
AXIOM_DATASET=
# ── Axiom (app.axiom.co) — observability ─────────────────────────────────────
# Isi AXIOM_TOKEN dari Settings > API Tokens di app.axiom.co. Pakai token yang
# dibatasi ke SATU dataset dengan izin ingest saja; personal token juga perlu
# AXIOM_ORG_ID. Token TIDAK BOLEH masuk ke git — ini hanya contoh.
AXIOM_ENABLED=false
AXIOM_TOKEN=
AXIOM_DATASET=sekarya
AXIOM_ORG_ID=
AXIOM_SERVICE=sekarya-api
# Diisi CI dengan git SHA supaya lonjakan galat bisa dikaitkan ke deploy.
AXIOM_RELEASE=

# sync = dikirim saat request selesai; queue = dititipkan ke worker.
AXIOM_DELIVERY=sync

# Kirim Log::* aplikasi ke Axiom juga. JANGAN hilangkan `single`: kalau Axiom
# tidak terjangkau, jejak galat harus tetap ada di server.
# LOG_STACK=single,axiom

# Privasi. prefix_hash = /24 + HMAC; pilihan lain: prefix, hash, full, none.
AXIOM_IP_MODE=prefix_hash
AXIOM_PSEUDONYMIZE=true
AXIOM_REQUEST_PAYLOAD=redacted
AXIOM_RESPONSE_PAYLOAD=errors_only
AXIOM_SCRUB_VALUES=true

# Ambang & sampling
AXIOM_SLOW_QUERY_MS=200
AXIOM_SLOW_REQUEST_MS=1000
AXIOM_SAMPLE_SUCCESS=1.0

# ── Firebase Cloud Messaging (push notification) ─────────────────────────────
# Pengiriman push memakai FCM HTTP v1, yang menuntut access token OAuth2
# bertanda tangan kunci privat service account. Unduh berkas JSON service
# account dari Firebase Console > Project Settings > Service Accounts, simpan
# DI LUAR git (mis. storage/app/firebase/service-account.json), lalu tunjuk
# path absolutnya di sini. Biarkan `false` untuk melewati seluruh pengiriman.
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS=
FIREBASE_TIMEOUT=10
